#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(
      tmux list-sessions -F "#{session_last_attached} #{session_name} #{session_path}" \
      | sort -nr \
      | awk '{printf "%-30s %s\n", $2, substr($0, index($0,$3))}' \
      | fzf --layout=reverse)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(echo "$selected" | awk '{print $1}')
selected_dir=$(echo "$selected" | sed 's/^[^ ]\+ *//')

tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s "$selected_name" -c "$selected_dir"
    exit 0
fi

if [[ -z $TMUX ]]; then
    tmux attach -t "$selected_name"
else
    tmux switch-client -t "$selected_name"
fi

