#!/bin/bash

function send_notification() {

  active_monitor=$(xrandr --query | grep " connected primary" | awk '{print $1}')
	volume=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $2 * 100}')
	# dunstify -a "changevolume" -u low -r "9993" -h int:value:"$volume" "Volume: ${volume}%" -t 2000
	dunstify -a "changevolume" -u low  -h string:x-dunst-stack-tag:Volume -h int:value:"$volume" "Volume:${volume}%" -t 2000 -h string:x-dunst-monitor:$active_monitor

}

function unmute(){
if wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q '\[MUTED\]'; then
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
  fi
}

case $1 in
up)
	# Set the volume on (if it was muted)
  unmute
  wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
	send_notification $1
	;;
down)
  unmute
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
	send_notification $1
	;;
mute)
  wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
	if $(pamixer --get-mute); then
		dunstify -a "changevolume" -t 2000 -r 9993 -u low "Muted"
	else
		send_notification up
	fi
	;;
esac
